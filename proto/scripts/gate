#!/usr/bin/env bash
# The local gate (#403): run this before you open a pull request. It is stricter than CI on purpose (CI stays light):
# the same checks CI runs, plus the property tests and the models with a bigger budget, one fixed seed, and the
# test-clock and dependency checks. It stops at the first failure and says how to replay it.
#
#   proto/scripts/gate            the usual gate
#   proto/scripts/gate --long     the same with many more property cases (5000 each, by hand, takes minutes)
#   proto/scripts/gate --allow-dirty   run although tracked files differ from the commit (see below)
#
# The gate checks the commit CI will see. cargo fmt, clippy and the tests read the working tree, so a file you edited
# after committing could pass here and fail in CI (#763): the gate refuses when a tracked file has uncommitted changes
# (staged or not), names them, and runs nothing; it also refuses an untracked, not ignored file under proto/, clients/
# or release/ (#785: a new source file left out of the commit). --allow-dirty checks the working tree
# anyway and says so.
#
# The Hegel seed is taken from the commit you are on, so a failure repeats exactly and each commit tries different
# cases. Set HEGEL_SEED yourself to use another. `proto/scripts/install-git-hook` makes a pre-push hook that runs this
# (opt in; never installed by default). Set GATE_LOG=<file> to append the full output of each release and shell check (#1081).
set -uo pipefail

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; echo; echo "Usage: proto/scripts/gate [--long] [--allow-dirty]"; }
long=0
allow_dirty=0
for arg in "$@"; do
  case "$arg" in
    --long) long=1 ;;
    --allow-dirty) allow_dirty=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "gate: unknown option $arg" >&2; usage >&2; exit 2 ;;
  esac
done

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
# rustup puts cargo in ~/.cargo/bin; add it only if cargo is not already on the PATH (so the one you chose wins)
command -v cargo > /dev/null 2>&1 || export PATH="$HOME/.cargo/bin:$PATH"

# the gate checks the commit: refuse a dirty tree for tracked files (a checkout with no git, such as an export, has no commit)
if git -C "$root" rev-parse --git-dir > /dev/null 2>&1; then
  dirty="$(git -C "$root" status --porcelain --untracked-files=no 2> /dev/null)"
  if [ -n "$dirty" ] && [ "$allow_dirty" -eq 1 ]; then
    echo "gate: --allow-dirty: tracked files have uncommitted changes; checking the working tree, not the commit (CI checks the commit)"
  elif [ -n "$dirty" ]; then
    echo "gate: refusing to run: tracked files have uncommitted changes:" >&2
    printf '%s\n' "$dirty" | head -n 20 | sed 's/^/    /' >&2
    echo "The gate reads the working tree but CI checks the commit, so a gate that passes here can fail there (#763)." >&2
    echo "Commit or discard the changes and run it again, or pass --allow-dirty to check the working tree anyway." >&2
    exit 1
  fi
  # a new source file left out of the commit builds here and fails in CI (#785); ignored files are not listed
  untracked="$(git -C "$root" ls-files --others --exclude-standard -- proto clients release 2> /dev/null)"
  if [ -n "$untracked" ] && [ "$allow_dirty" -eq 1 ]; then
    echo "gate: --allow-dirty: untracked files under proto/, clients/ or release/ are in the working tree but not in the commit"
  elif [ -n "$untracked" ]; then
    echo "gate: refusing to run: untracked files under proto/, clients/ or release/ (not in the commit CI checks):" >&2
    printf '%s\n' "$untracked" | head -n 20 | sed 's/^/    /' >&2
    echo "A file a committed mod line needs but that was never added builds here and fails in CI (#785)." >&2
    echo "git add it (or delete it, or list it in .gitignore) and run again, or pass --allow-dirty to check the working tree anyway." >&2
    exit 1
  fi
fi

sha="$(git -C "$root" rev-parse --short=8 HEAD 2>/dev/null || echo 00000000)"
export HEGEL_SEED="${HEGEL_SEED:-$((16#$sha))}"
cases=500
[ "$long" -eq 1 ] && cases=5000
log="$(mktemp "${TMPDIR:-/tmp}/klatch-gate.XXXXXX")"
trap 'rm -f "$log"' EXIT

total=14
n=0
started=$SECONDS
replay_hint() {
  echo
  echo "To replay the property tests exactly:"
  echo "    cd proto && HEGEL_SEED=$HEGEL_SEED HEGEL_TEST_CASES=$cases cargo test -p klatch --test properties --test models --test crypto"
  echo "A failing property also prints its shrunk input and a line #[hegel::reproduce_failure(\"...\")]: add it under"
  echo "#[hegel::test] to replay that one failure from the blob alone (CONTRIBUTING.md, \"Property tests\")."
}
# step <name> <hegel?> <dir> <command...>
step() {
  local name="$1" hegel="$2" dir="$3"
  shift 3
  n=$((n + 1))
  local t0=$SECONDS
  if (cd "$dir" && "$@") > "$log" 2>&1; then
    printf '[%d/%d] %-34s ok (%ds)\n' "$n" "$total" "$name" $((SECONDS - t0))
  else
    printf '[%d/%d] %-34s FAILED\n' "$n" "$total" "$name"
    echo
    echo "FAILED at step $n: $name"
    echo "----- last lines of its output -----"
    tail -n 50 "$log"
    echo "-------------------------------------"
    [ "$hegel" = "hegel" ] && replay_hint
    exit 1
  fi
}

# #1101: a gate run once left about 50 orphaned /bin/sleep 3600 processes (the team watchdog) and fork failed machine-wide.
# Count them now and fail at the end if the run added any (sleeps another session left earlier are not blamed on this run).
# Only sleeps in THIS run's process group count: an orphan keeps the process group of the script that started it, so a gate in
# another worktree (a builder still on an older base that has the leak) cannot fail this run. (A sleep's environment is not
# readable on macOS, so a marker variable cannot be used.)
my_pgid="$(ps -o pgid= -p $$ | tr -d ' ')"
sleepers() {
  local pid n=0
  for pid in $(pgrep -f '/bin/sleep 3600' 2> /dev/null); do
    [ "$(ps -o pgid= -p "$pid" 2> /dev/null | tr -d ' ')" = "$my_pgid" ] && n=$((n + 1))
  done
  echo "$n"
}
sleepers_before="$(sleepers)"

proto="$root/proto"
step "fmt"                          no    "$proto" cargo fmt --all --check
step "clippy (warnings are errors)" no    "$proto" cargo clippy --workspace --all-targets --locked -- -D warnings
# The CI step "the client feature and the bare build compile on their own" (#910): a module declared without its
# #[cfg(feature = "cli")] builds under the default features and breaks only these two, so CI alone caught it.
step "feature and bare builds"      no    "$proto" bash -c 'cargo build -p klatch --no-default-features --features client --locked && cargo build -p klatch --no-default-features --locked'
# the optional real Jev transport (#871) is behind a feature no default build compiles: lint and test it here
step "jev-http feature"             no    "$proto" bash -c 'cargo clippy -p klatch --features jev-http --all-targets --locked -- -D warnings && cargo test -p klatch --features jev-http --lib --locked jev::'
# The CI step "Unit and integration tests" runs cargo nextest and then the doctests (#1331). A machine without nextest
# falls back to cargo test and says so (cargo install cargo-nextest --locked, or brew install cargo-nextest).
workspace_tests() {
  if cargo nextest --version > /dev/null 2>&1; then
    cargo nextest run --workspace --locked && cargo test --workspace --doc --locked
  else
    cargo test --workspace --locked
  fi
}
if ! cargo nextest --version > /dev/null 2>&1; then
  echo "gate: cargo-nextest is not installed; the workspace tests run with cargo test (CI uses nextest; install it for the faster, same run)"
fi
step "workspace tests"              hegel "$proto" workspace_tests
# a credentialed worker runs this gate with KLATCH_IDENTITY_FILE set (#613); set a throwaway one on purpose and run
# the suites that build their own homes, to prove they are immune to it
step "immune to an inherited bundle" no   "$proto" env KLATCH_IDENTITY_FILE=/nonexistent/gate-bogus.bundle cargo test -p klatch --locked --test caller --test anchor --test board --test lobby --test claim_target --test clarify
# cargo-deny reads the advisory database and the licence policy; a machine without it skips the step and says so
if cargo deny --version > /dev/null 2>&1; then
  step "cargo deny"                 no    "$proto" cargo deny --manifest-path Cargo.toml check
else
  n=$((n + 1)); printf '[%d/%d] %-34s skipped (cargo-deny is not installed; CI runs it)\n' "$n" "$total" "cargo deny"
fi
step "test-clock build tests"       no    "$proto" cargo test -p klatch --features test-clock --test no_plaintext --locked
step "property tests and models"    hegel "$proto" env HEGEL_TEST_CASES="$cases" cargo test -p klatch --locked --test properties --test models --test crypto
# Shuttle smoke (#406): 200 random schedules of each std-thread test, in its own target dir (so a cold first run builds
# for about 40 s, then it is seconds). The long run and the mutation check are by hand: proto/scripts/shuttle
step "shuttle smoke (200 schedules)" no   "$root" proto/scripts/shuttle smoke
# the repository's own scripts: the release number agrees everywhere, the installer, the README quickstart, shellcheck
# check <command...>: one check of the step below (#1081). Its output is kept, not discarded: nothing is printed when it
# passes (the step stays as quiet as before), and when it fails the command line and the last 40 lines of its stdout and
# stderr are printed, so a failure that does not repeat still says which command it was. With GATE_LOG set to a file path,
# every check's command line, full output and exit status are appended to that file (off by default).
check() {
  local out rc=0
  out="$(mktemp "${TMPDIR:-/tmp}/klatch-gate-check.XXXXXX")"
  "$@" > "$out" 2>&1 || rc=$?
  if [ -n "${GATE_LOG:-}" ]; then
    { printf '### %s\n' "$*"; cat "$out"; printf '### exit status %d\n' "$rc"; } >> "$GATE_LOG" 2> /dev/null || true
  fi
  if [ "$rc" -ne 0 ]; then
    printf 'check failed (exit status %d): %s\n' "$rc" "$*"
    echo "----- last 40 lines of its stdout and stderr -----"
    tail -n 40 "$out"
  fi
  rm -f "$out"
  return "$rc"
}
repo_checks() {
  cargo build -p klatch --locked --manifest-path "$proto/Cargo.toml" > /dev/null 2>&1 || true
  check release/check-timeouts.sh \
    && check release/check-versions.sh \
    && check release/test-check-versions.sh \
    && check release/test-package-archive.sh \
    && check bash -c 'cd clients/python && python3 -m unittest discover' \
    && check python3 -m unittest discover -s clients/recipes -p 'test_*.py' \
    && check release/changelog-fragments.sh check \
    && check release/test-changelog-fragments.sh \
    && check release/design-fragments.sh check \
    && check release/test-design-fragments.sh \
    && check release/research-fragments.sh check \
    && check release/test-research-fragments.sh \
    && check release/test-renumber-refs.sh \
    && check release/test-rehearse-assemble.sh \
    && check release/test-release-notes.sh \
    && check release/test-bump-formula.sh \
    && check release/test-compare-formula.sh \
    && check release/test-tag-checks.sh \
    && check release/test-rollback-rehearsal.sh \
    && check release/test-verify-published.sh \
    && check release/check-union-duplicates.sh \
    && check release/test-check-union-duplicates.sh \
    && check release/check-sigpipe.sh \
    && check release/test-check-sigpipe.sh \
    && check proto/scripts/test-team.sh \
    && check proto/scripts/test-sweep.sh \
    && check proto/scripts/test-gh-watch.sh \
    && check proto/scripts/test-codescene-components.sh \
    && check proto/scripts/test-integrator.sh \
    && check proto/scripts/test-ask-supervisor.sh \
    && check proto/scripts/test-merge-union.sh \
    && check proto/scripts/test-fmt-after-merge.sh \
    && check sh install/test-install.sh \
    && check experiments/gates/test-check-binary.sh \
    && check experiments/variance/test-repeat.sh \
    && check experiments/dm-adoption/test-dm-adoption.sh \
    && check env KLATCH_BIN="$proto/target/debug/klatch" bash clients/recipes/readme-quickstart.sh \
    && check env KLATCH_BIN="$proto/target/debug/klatch" bash clients/recipes/check-integration-examples.sh \
    && check env KLATCH_BIN="$proto/target/debug/klatch" bash clients/recipes/launcher-demo.sh \
    && { ! command -v actionlint > /dev/null 2>&1 || check actionlint; } \
    && { ! command -v shellcheck > /dev/null 2>&1 || check shellcheck install/*.sh release/*.sh clients/recipes/*.sh experiments/gates/check-binary.sh experiments/gates/test-check-binary.sh experiments/variance/test-repeat.sh experiments/dm-adoption/run.sh experiments/dm-adoption/test-dm-adoption.sh proto/scripts/gate proto/scripts/install-git-hook proto/scripts/test-scripts.sh proto/scripts/team proto/scripts/test-team.sh proto/scripts/pr-sweep proto/scripts/test-sweep.sh proto/scripts/gh-watch proto/scripts/test-gh-watch.sh proto/scripts/test-codescene-components.sh proto/scripts/test-merge-union.sh proto/scripts/authz-audit proto/scripts/fmt-after-merge proto/scripts/test-fmt-after-merge.sh proto/scripts/quint-check proto/scripts/shuttle proto/scripts/integrator proto/scripts/test-integrator.sh proto/scripts/ask-supervisor proto/scripts/test-ask-supervisor.sh; }
}
step "release and shell checks"     no    "$root" repo_checks

# CI steps the gate did not run (#1034). Each runs here too; the two that need a tool the machine may lack skip with a message,
# as cargo deny does. The gate refuses a dirty tree, so the dry run packages the commit; --allow-dirty is passed on only
# when the gate itself was told to check the working tree.
publish_args=(--dry-run --locked -p klatch)
[ "$allow_dirty" -eq 1 ] && publish_args+=(--allow-dirty)
step "crates.io dry run"            no    "$proto" cargo publish "${publish_args[@]}"
if command -v node > /dev/null 2>&1 && command -v npm > /dev/null 2>&1; then
  # the same commands as the CI step; npm ci needs the network
  ts_tests() {
    (cd "$root/clients/typescript" && KLATCH_BIN="$proto/target/debug/klatch" node --experimental-strip-types --test conformance.test.ts http.test.ts) \
      && (cd "$root/clients/typescript" && npm ci --ignore-scripts && node --experimental-strip-types --test package.test.ts)
  }
  step "TypeScript client tests"    no    "$root" ts_tests
else
  n=$((n + 1)); printf '[%d/%d] %-34s skipped (node is not installed; CI runs it)\n' "$n" "$total" "TypeScript client tests"
fi
if command -v cargo-about > /dev/null 2>&1; then
  step "licence notices"            no    "$proto" ./check-notices.sh
else
  n=$((n + 1)); printf '[%d/%d] %-34s skipped (cargo-about is not installed; CI runs it)\n' "$n" "$total" "licence notices"
fi

sleepers_after="$(sleepers)"
if [ "$sleepers_after" -gt "$sleepers_before" ]; then
  echo "gate: FAILED: the run left $((sleepers_after - sleepers_before)) orphaned '/bin/sleep 3600' process(es) behind (#1101)." >&2
  echo "Find the script or test that starts a background sleep and stops only its parent; clean up with: pkill -9 -f 'sleep 3600'" >&2
  exit 1
fi

echo
echo "GATE PASSED in $((SECONDS - started))s (Hegel seed $HEGEL_SEED, $cases cases each)"
