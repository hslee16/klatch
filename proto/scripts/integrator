#!/usr/bin/env bash
# integrator: the merge queue's integrator PROCESS (#866, step 3 of epic #863). See INTEGRATOR.md.
#
#   integrator [--once]        run until a signal (INT, TERM, HUP); --once drains the queue and exits (for a hand run)
#   integrator --merge-without-update [--verify-gate] [--verify-bench]    (#867, OFF BY DEFAULT; see below)
#   integrator --dry-run       (#1075) check the setup, read the queue and the open PRs, run the conflict pre-check, and PRINT
#                              what a real run would post and merge; it posts, claims, pushes, merges and starts nothing
#   integrator --normalize     (internal) turn a stream of webhook payloads on standard input into tab separated lines
#   integrator --pr | --pulls | --checks    (internal) validate one gh api answer on standard input
#
# It runs OUTSIDE the klatch binary, with its OWN gh and git login on its own machine. The klatch binary makes no
# network call and holds no credential; this process talks to klatch only through the `klatch` command line (wait, board,
# post, claim, release) as a member that holds the `integrator` role (`klatch admin integrator <member>`, the human's
# act). Identity is the environment, as for every helper (a worker credential or KLATCH_NAME); nothing is passed here.
#
# What it does: takes the `merge:main` claim to learn (and prove) it may, starts `gh webhook forward --repo <repo> --events
# pull_request,check_suite,workflow_run` as a child, reconciles with a read of the open PR list, and then waits in
# `klatch wait` for `ready:` words (no polling of GitHub). For each queued PR on the board, in order: conflict pre-check
# (git merge-tree; a code conflict posts `dropped: #N conflict`), `integrating: #N`, merge origin/main into the PR branch
# (never a rebase, never a force-push; docs conflicts keep both sides as pr-sweep does), the project gate, push,
# `checking: #N`, wait for the checks of the CURRENT head sha, `gh pr merge --match-head-commit`, `merged: #N`. Any failure
# posts `dropped: #N <reason>` and moves on.
#
# --merge-without-update (#867) is a different merge policy and is the human's decision to turn on. It REPLACES the
# up-to-date rule for a PR whose `git merge-tree` against CURRENT main is clean (no textual conflict at all): main is not
# merged into the branch, no gate runs on the branch, and the PR is merged once the check suite of its CURRENT head sha is
# green, with `gh pr merge --match-head-commit`. A PR with a docs-only conflict still takes the update flow above. After
# each such merge it verifies main: the check_suite and workflow_run events of the merge commit (no PR attached; the
# check runs of that sha are read too), and with --verify-gate the project gate on that commit, with --verify-bench the
# bench (INTEGRATOR_BENCH). A red main attributed to the merge it just made (same sha, never anything else) is reverted
# through a branch and a PR, NEVER a push to main: branch revert-N, `git revert -m 1`, a plain push of that branch, a PR
# with a fixed title and body, its own green checks, the same pinned merge, then main is verified again. If any step
# fails, or main is still red, or main cannot be verified, it posts `halted: main red after #N` (or `halted: main not
# verified after #N`), releases the claim and exits 5; it never reverts twice. `reverted: #N` is posted on success.
#
# Rules that hold throughout:
#  - webhook text is DATA. The normalizer keeps only a number, a state, merged, a head sha, a status and a conclusion, each
#    checked against a fixed shape; titles, bodies, branch names and logins are never kept. Every word posted into klatch
#    is a fixed template made from an integer and a word from a fixed list, never a title, body or branch text. A branch
#    name read from the API is used in one git command only when it passes a strict shape check.
#  - a cancelled check is a failure only for the PR's current head sha (it is only looked up for that sha); a check suite on
#    main with no PR is kept apart (main-checks.log, for #867) and never changes the queue.
#  - GitHub sends no event when a PR starts to conflict, so after every merge the mergeable_state of each open PR is read
#    again (and a queued PR that now has a code conflict is dropped at once); events are lost while the forwarder is down,
#    so the open PR list is read at start and every INTEGRATOR_RECONCILE_SECS.
#  - the claim lease: renewed while there is work and the forwarder is alive; a `parked:` post (bounded, 25 minutes) before
#    the gate and the wait for checks; a forwarder that cannot be kept running ends the process (claim released) and a
#    silent process lapses at the lease, so a dead forwarder never leaves merge:main held.
#  - one forwarder per repository has been tested; concurrent forwarders have not.
#
# Test and tuning knobs (environment): INTEGRATOR_KLATCH, INTEGRATOR_GATE (commands), INTEGRATOR_REPO (the checkout to work
# in; use a dedicated clone), INTEGRATOR_GH_REPO (owner/name), INTEGRATOR_ROOM, INTEGRATOR_FORWARD (command that prints the
# webhook payloads), INTEGRATOR_LEASE_SECS, INTEGRATOR_RECONCILE_SECS, INTEGRATOR_PARK_MINUTES, INTEGRATOR_CHECK_WAIT_SECS,
# INTEGRATOR_POLL_SECS, INTEGRATOR_GH_TIMEOUT, INTEGRATOR_GH_RETRY_SLEEP, INTEGRATOR_FORWARDER_TRIES,
# INTEGRATOR_FORWARDER_MIN_UP, INTEGRATOR_REQUEUE_SECS, INTEGRATOR_STATE (state directory), INTEGRATOR_TEST_DROP_TERMS,
# INTEGRATOR_VERIFY_WAIT_SECS (how long to wait for main's checks after a merge; default the check wait), INTEGRATOR_BENCH
# (the bench command for --verify-bench; default: cargo run -q --release -p klatch-bench from proto/).
# Exit codes: 0 stopped by a signal or --once drained; 1 usage or setup; 2 refused the merge:main claim (not an integrator);
# 3 the claim is held by another or was lost; 4 the event source (the forwarder) could not be kept running; 5 halted: main
# is red or could not be verified after a merge made without updating the branch (the human must look).
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

# ---------------------------------------------------------------------------------------------------------------------
# the data filters (python3 -I, standard library only). Everything that enters this process from GitHub goes through one.
# ---------------------------------------------------------------------------------------------------------------------
py_filter() {
  python3 -I -c "$(cat <<'PY'
import json, re, sys
mode = sys.argv[1]
HEX = re.compile(r'^[0-9a-f]{40}$')
STATUS = {'queued', 'in_progress', 'completed', 'requested', 'waiting', 'pending'}
CONCL = {'success', 'failure', 'cancelled', 'timed_out', 'neutral', 'skipped', 'action_required', 'startup_failure', 'stale'}
MSTATE = {'clean', 'dirty', 'blocked', 'behind', 'unstable', 'unknown', 'draft', 'has_hooks'}
REF = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$')
REPO = re.compile(r'^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$')

def num(v):
    return v if isinstance(v, int) and not isinstance(v, bool) and 0 < v < 10**9 else None
def sha(v):
    return v if isinstance(v, str) and HEX.match(v) else None
def word(v, allowed):
    if v is None:
        return '-'
    return v if isinstance(v, str) and v in allowed else 'other'
def get(d, *path):
    for k in path:
        if not isinstance(d, dict):
            return None
        d = d.get(k)
    return d

def normalize(obj):
    if not isinstance(obj, dict):
        return None
    if isinstance(obj.get('pull_request'), dict):
        n, s, h = num(obj.get('number')), get(obj, 'pull_request', 'state'), sha(get(obj, 'pull_request', 'head', 'sha'))
        if n is None or s not in ('open', 'closed') or h is None:
            return None
        return 'pr\t%d\t%s\t%s\t%s' % (n, s, 'true' if get(obj, 'pull_request', 'merged') is True else 'false', h)
    for key in ('check_suite', 'workflow_run'):
        if isinstance(obj.get(key), dict):
            h = sha(get(obj, key, 'head_sha'))
            if h is None:
                return None
            prs = get(obj, key, 'pull_requests')
            nums = sorted({num(p.get('number')) for p in prs if isinstance(p, dict)} - {None}) if isinstance(prs, list) else []
            return 'check\t%s\t%s\t%s\t%s' % (h, word(get(obj, key, 'status'), STATUS), word(get(obj, key, 'conclusion'), CONCL),
                                              ','.join(str(x) for x in nums) or '-')
    return None

if mode == 'normalize':
    # a stream of payloads, one per line or pretty printed; each is emitted as soon as it is complete
    dec = json.JSONDecoder()
    buf = ''
    for line in sys.stdin:
        buf += line
        while True:
            s = buf.lstrip()
            if not s:
                buf = ''
                break
            try:
                obj, j = dec.raw_decode(s)
            except ValueError:
                if s[0] not in '{[':
                    nl = s.find('\n')
                    buf = '' if nl < 0 else s[nl + 1:]
                    continue
                buf = '' if len(s) > 4000000 else s
                break
            r = normalize(obj)
            if r:
                sys.stdout.write(r + '\n')
                sys.stdout.flush()
            buf = s[j:]
    sys.exit(0)

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)

if mode == 'pr':
    st = get(data, 'state')
    ref = get(data, 'head', 'ref')
    repo = get(data, 'head', 'repo', 'full_name')
    ms = get(data, 'mergeable_state')
    print('\t'.join([
        st if st in ('open', 'closed') else 'other',
        'true' if get(data, 'merged') is True else 'false',
        sha(get(data, 'head', 'sha')) or '-',
        ref if isinstance(ref, str) and REF.match(ref) and '..' not in ref and not ref.endswith(('.lock', '/', '.')) else '-',
        repo if isinstance(repo, str) and REPO.match(repo) else '-',
        ms if ms in MSTATE else 'other',
        sha(get(data, 'merge_commit_sha')) or '-']))
elif mode == 'pulls':
    if isinstance(data, list):
        for p in data:
            n, h = num(get(p, 'number')), sha(get(p, 'head', 'sha'))
            if n is not None and h is not None:
                print('%d\t%s' % (n, h))
elif mode == 'perm':
    p = get(data, 'permissions')
    print('admin' if get(p, 'admin') is True else 'push' if get(p, 'push') is True else 'none')
elif mode == 'mchecks':
    # the check runs of a commit on main: red only for a real failure; a cancelled run is its own answer (superseded)
    runs = get(data, 'check_runs')
    if not isinstance(runs, list) or not runs:
        print('none')
    else:
        v = 'green'
        for r in runs:
            if get(r, 'status') != 'completed':
                if v == 'green':
                    v = 'pending'
                continue
            c = get(r, 'conclusion')
            if c in ('failure', 'timed_out', 'startup_failure', 'action_required'):
                v = 'red'
                break
            if c in ('cancelled', 'stale'):
                v = 'cancelled'
            elif c not in ('success', 'skipped', 'neutral'):
                v = 'red'
                break
        print(v)
elif mode == 'checks':
    runs = get(data, 'check_runs')
    if not isinstance(runs, list) or not runs:
        print('none')
    else:
        v = 'green'
        for r in runs:
            if get(r, 'status') != 'completed':
                if v == 'green':
                    v = 'pending'
                continue
            if get(r, 'conclusion') not in ('success', 'skipped', 'neutral'):
                v = 'red'
                break
        print(v)
PY
)" "$1"
}

case "${1:-}" in
  --normalize) py_filter normalize; exit $? ;;
  --pr) py_filter pr; exit $? ;;
  --pulls) py_filter pulls; exit $? ;;
  --checks) py_filter checks; exit $? ;;
  --mchecks) py_filter mchecks; exit $? ;;
  -h | --help) sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

orig_args=("$@")
once=0
dry=0
mwu=0
verify_gate=0
verify_bench=0
while [ $# -gt 0 ]; do
  case "$1" in
    --once) once=1 ;;
    --dry-run) dry=1 ;;
    --merge-without-update) mwu=1 ;;
    --verify-gate) verify_gate=1 ;;
    --verify-bench) verify_bench=1 ;;
    *) echo "integrator: unknown argument $1" >&2; exit 1 ;;
  esac
  shift
done

if [ "$mwu" -eq 0 ] && [ $((verify_gate + verify_bench)) -gt 0 ]; then
  echo "integrator: --verify-gate and --verify-bench only work with --merge-without-update" >&2; exit 1
fi
# ---------------------------------------------------------------------------------------------------------------------
# the supervisor (#1099). bash 3.2 (the macOS /bin/bash) LOSES a trapped signal that lands while the shell is expanding a
# command substitution: the trap string cannot be parsed ("unexpected EOF while looking for matching `)'") and the TERM is
# gone, so a plain `kill -TERM` sometimes never stopped the integrator. The loop below cannot avoid command substitutions,
# so the real work runs in a child (INTEGRATOR_WORKER=1) and this small parent, which runs no command substitution, only
# waits. A signal sets a flag; the parent then sends TERM to the worker once a second until it is gone, so a TERM the worker
# lost is sent again. The worker's stop is idempotent, and it stops by itself when this parent is gone (kill -9).
# ---------------------------------------------------------------------------------------------------------------------
sup_sig=0
supervise() { # the flags of this run: starts the worker, returns its exit code
  local wpid rc sp tries=0
  INTEGRATOR_WORKER=1 INTEGRATOR_SUPERVISOR=$$ bash "$0" "$@" &
  wpid=$!
  trap 'sup_sig=1' INT TERM HUP
  while kill -0 "$wpid" 2> /dev/null; do
    if [ "$sup_sig" -eq 1 ]; then
      tries=$((tries + 1))
      if [ "$tries" -gt 60 ]; then kill -9 "$wpid" 2> /dev/null; else kill -TERM "$wpid" 2> /dev/null; fi
      /bin/sleep 1 &
      sp=$!
      wait "$sp"
    else
      wait "$wpid"
    fi
  done
  wait "$wpid"; rc=$?
  return "$rc"
}
if [ "$dry" -eq 0 ] && [ "${INTEGRATOR_WORKER:-}" != 1 ]; then
  supervise ${orig_args[@]+"${orig_args[@]}"}
  exit $?
fi
sup_alive() { [ -z "${INTEGRATOR_SUPERVISOR:-}" ] || kill -0 "$INTEGRATOR_SUPERVISOR" 2> /dev/null; }

export PATH="$HOME/.cargo/bin:$PATH"
slug="${INTEGRATOR_GH_REPO:-hslee16/klatch}"
room="${INTEGRATOR_ROOM:-lobby}"
klatch="${INTEGRATOR_KLATCH:-klatch}"
lease="${INTEGRATOR_LEASE_SECS:-600}"
reconcile_secs="${INTEGRATOR_RECONCILE_SECS:-300}"
park_min="${INTEGRATOR_PARK_MINUTES:-25}"
check_wait="${INTEGRATOR_CHECK_WAIT_SECS:-5400}"
poll="${INTEGRATOR_POLL_SECS:-1}"
gh_timeout="${INTEGRATOR_GH_TIMEOUT:-60}"
gh_retry_sleep="${INTEGRATOR_GH_RETRY_SLEEP:-2}"
fwd_tries="${INTEGRATOR_FORWARDER_TRIES:-3}"
fwd_min_up="${INTEGRATOR_FORWARDER_MIN_UP:-30}"
requeue_secs="${INTEGRATOR_REQUEUE_SECS:-30}"
verify_wait="${INTEGRATOR_VERIFY_WAIT_SECS:-$check_wait}"

say() { printf 'integrator: %s\n' "$*" >&2; }
nap() { /bin/sleep "$1"; }

case "$lease$reconcile_secs$park_min$check_wait$verify_wait" in *[!0-9]*) say "the lease, reconcile, park and check-wait settings must be whole numbers"; exit 1 ;; esac
[ "$reconcile_secs" -ge 1 ] && [ "$reconcile_secs" -le 300 ] || { say "INTEGRATOR_RECONCILE_SECS must be 1 to 300"; exit 1; }

repo="${INTEGRATOR_REPO:-}"
[ -n "$repo" ] || { say "set INTEGRATOR_REPO to a dedicated clone of $slug (see INTEGRATOR.md); this process switches its branches"; exit 1; }
cd "$repo" || { say "cannot enter $repo"; exit 1; }
run="${INTEGRATOR_STATE:-$(mktemp -d "${TMPDIR:-/tmp}/integrator-run.XXXXXX")}" || { say "cannot make a state directory"; exit 1; }
mkdir -p "$run"
: > "$run/ev.tsv"; : > "$run/checks.log"; : > "$run/main-checks.log"

docs_re='^(DESIGN.md|CHANGELOG.md|VERSIONING.md|RESEARCH-NOTES.md|proto/klatch-bench/src/scenarios/mod.rs)$' # as pr-sweep

# ---------------------------------------------------------------------------------------------------------------------
# process control: every long command runs in the background and is waited for, so a signal is handled at once
# ---------------------------------------------------------------------------------------------------------------------
fpid=""; npid=""; cpid=""; held=0; cur=""; stopping=0
cleanup() {
  [ "$stopping" -eq 1 ] && return
  stopping=1
  trap '' INT TERM HUP
  [ -n "$cpid" ] && kill -TERM "$cpid" 2> /dev/null
  stop_forwarder
  [ -n "$cur" ] && git merge --abort > /dev/null 2>&1
  if [ "$held" -eq 1 ]; then "$klatch" release "$room" merge:main > /dev/null 2>&1; held=0; fi
  rm -rf "$run"
}
dropped_terms=0
on_signal() {
  [ "$stopping" -eq 1 ] && return # a repeated signal (the supervisor sends one a second) never cuts the cleanup short
  # test knob: pretend the first N signals were lost, as bash 3.2 does; the supervisor must send them again
  if [ "$dropped_terms" -lt "${INTEGRATOR_TEST_DROP_TERMS:-0}" ]; then dropped_terms=$((dropped_terms + 1)); return; fi
  say "signal received; stopping"; cleanup; exit 0
}
trap on_signal INT TERM HUP
trap cleanup EXIT

bg() { # outfile, command...: run it in the background, wait (a trap can interrupt), print nothing; its exit code
  local out=$1 rc
  shift
  "$@" > "$out" 2>&1 &
  cpid=$!
  wait "$cpid"; rc=$?
  cpid=""
  return $rc
}

ghx() { # gh arguments: stdout of gh, 3 tries, a timeout (a perl alarm survives the exec; macOS has no timeout)
  local i=0 out rc
  while [ "$i" -lt 3 ]; do
    out="$(perl -e 'alarm shift; exec @ARGV' "$gh_timeout" gh "$@" 2> /dev/null)"; rc=$?
    if [ "$rc" -eq 0 ]; then printf '%s\n' "$out"; return 0; fi
    i=$((i + 1))
    [ "$i" -lt 3 ] && [ "$gh_retry_sleep" != 0 ] && nap "$gh_retry_sleep"
  done
  return 1
}

# ---------------------------------------------------------------------------------------------------------------------
# klatch: the claim and the words. A word is a fixed template of an integer and a fixed reason.
# ---------------------------------------------------------------------------------------------------------------------
post() { # the whole word (built only by the helpers below)
  "$klatch" post "$room" "$1" > /dev/null 2>&1 || say "post failed: $1"
  renew_claim
}
post_integrating() { post "$(printf 'integrating: #%d' "$1")"; }
post_checking() { post "$(printf 'checking: #%d' "$1")"; }
post_merged() { post "$(printf 'merged: #%d' "$1")"; }
post_dropped() { # PR, reason from the fixed list: conflict checks-failed closed timeout head-changed error
  case "$2" in conflict | checks-failed | closed | timeout | head-changed | error) ;; *) set -- "$1" error ;; esac
  say "#$1 dropped: $2"
  post "$(printf 'dropped: #%d %s' "$1" "$2")"
}
post_reverted() { post "$(printf 'reverted: #%d' "$1")"; }
post_halted() { # PR, red | unverified
  case "$2" in unverified) post "$(printf 'halted: main not verified after #%d' "$1")" ;;
    *) post "$(printf 'halted: main red after #%d' "$1")" ;; esac
}
post_parked() { # what is awaited: gate | checks
  case "$2" in gate) post "$(printf 'parked: running the gate for #%d, back by %dm' "$1" "$park_min")" ;;
    *) post "$(printf 'parked: waiting for checks on #%d, back by %dm' "$1" "$park_min")" ;; esac
}

# the claim: taken to start work and renewed while it goes on, only while the event source is alive
take_claim() { # 0 held; 1 refused by the role rule; 2 held by another or failed
  local out
  out="$("$klatch" claim "$room" merge:main --ttl "$lease" --reason integrating 2>&1)" && { held=1; return 0; }
  printf '%s\n' "$out" | head -3 >&2
  case "$out" in *"refused"*) return 1 ;; esac
  return 2
}
renew_claim() {
  [ "$held" -eq 1 ] || return 0
  [ -n "$fpid" ] && ! kill -0 "$fpid" 2> /dev/null && return 0 # a dead event source gets no renewal: the claim lapses
  "$klatch" claim "$room" merge:main --ttl "$lease" --reason integrating > /dev/null 2>&1 || { say "the merge:main claim was lost"; claim_lost=1; }
}
claim_lost=0
drop_claim() {
  if [ "$held" -eq 1 ]; then "$klatch" release "$room" merge:main > /dev/null 2>&1; held=0; fi
}

# ---------------------------------------------------------------------------------------------------------------------
# the event source: gh webhook forward as a child (own login, needs repo admin), and the files its events land in
# ---------------------------------------------------------------------------------------------------------------------
fwd_fails=0; fwd_started=0; off=0
start_forwarder() {
  rm -f "$run/raw"
  mkfifo "$run/raw" || return 1
  if [ -n "${INTEGRATOR_FORWARD:-}" ]; then "$INTEGRATOR_FORWARD" > "$run/raw" 2> /dev/null &
  else gh webhook forward --repo "$slug" --events pull_request,check_suite,workflow_run > "$run/raw" 2> /dev/null &
  fi
  fpid=$!
  python3 -I - "$run/raw" "$run/ev.tsv" "$0" <<'PY' &
import subprocess, sys
raw, out, me = sys.argv[1:4]
with open(raw, 'rb') as src, open(out, 'ab') as dst:
    subprocess.run(['bash', me, '--normalize'], stdin=src, stdout=dst)
PY
  npid=$!
  fwd_started=$(date +%s)
}
stop_forwarder() { # TERM first: gh removes its temporary webhook on exit (a -9 would leave it on the repository)
  local i=0
  if [ -n "$fpid" ]; then
    kill -TERM "$fpid" 2> /dev/null
    while kill -0 "$fpid" 2> /dev/null && [ "$i" -lt 50 ]; do nap 0.1; i=$((i + 1)); done
    kill -0 "$fpid" 2> /dev/null && kill -9 "$fpid" 2> /dev/null
    fpid=""
  fi
  if [ -n "$npid" ]; then kill -TERM "$npid" 2> /dev/null; wait "$npid" 2> /dev/null; npid=""; fi
}
ensure_forwarder() { # 0 running (restarted if it had died, then reconciled), 1 cannot be kept running
  [ -n "$fpid" ] && kill -0 "$fpid" 2> /dev/null && return 0
  local up=$(($(date +%s) - fwd_started))
  if [ "$up" -lt "$fwd_min_up" ]; then fwd_fails=$((fwd_fails + 1)); else fwd_fails=0; fi
  say "the webhook forwarder is not running (up $up s); fail count $fwd_fails"
  stop_forwarder
  if [ "$fwd_fails" -ge "$fwd_tries" ]; then return 1; fi
  start_forwarder || return 1
  reconcile
  return 0
}

# ---------------------------------------------------------------------------------------------------------------------
# state read from events and from the reconcile: head-N (current head sha), old-N (heads replaced), open-N, mstate-N
# ---------------------------------------------------------------------------------------------------------------------
note_head() { # PR, sha
  grep -qx "$2" "$run/old-$1" 2> /dev/null && return 0
  printf '%s\n' "$2" > "$run/head-$1"
}
supersede() { # PR, the sha replaced by a push of ours
  printf '%s\n' "$2" >> "$run/old-$1"
}
drain_events() {
  local total kind a b c d
  total="$(wc -l < "$run/ev.tsv" | tr -d ' ')"
  [ "$total" -gt "$off" ] || return 0
  while IFS=$'\t' read -r kind a b c d; do
    case "$kind" in
      pr) # number state merged sha
        case "$a" in '' | *[!0-9]*) continue ;; esac
        if [ "$b" = open ]; then : > "$run/open-$a"; note_head "$a" "$d"; else rm -f "$run/open-$a"; fi
        [ "$c" = true ] && : > "$run/merged-$a" ;;
      check) # sha status conclusion prs
        if [ "$d" != "-" ] || grep -qx "$a" "$run"/head-* 2> /dev/null; then printf '%s %s %s\n' "$a" "$b" "$c" >> "$run/checks.log"
        else printf '%s %s %s\n' "$a" "$b" "$c" >> "$run/main-checks.log"; fi ;;
    esac
  done < <(tail -n +"$((off + 1))" "$run/ev.tsv" | head -n "$((total - off))")
  off=$total
}
wait_events() { # up to $1 seconds for the event file to grow (a local file; GitHub is not read here)
  local end=$(($(date +%s) + $1)) size
  size="$(wc -l < "$run/ev.tsv" | tr -d ' ')"
  while [ "$(date +%s)" -lt "$end" ]; do
    [ "$(wc -l < "$run/ev.tsv" | tr -d ' ')" -gt "$size" ] && return 0
    nap "$poll"
  done
  return 1
}

pr_read() { # PR: sets pr_state pr_merged pr_sha pr_ref pr_repo pr_ms pr_msha (validated); 1 when it could not be read
  local out
  out="$(ghx api "repos/$slug/pulls/$1" | py_filter pr)" || return 1
  [ -n "$out" ] || return 1
  IFS=$'\t' read -r pr_state pr_merged pr_sha pr_ref pr_repo pr_ms pr_msha <<< "$out"
  return 0
}
mstate_of() { # PR: the mergeable_state, asked again while GitHub says unknown
  local u=0
  pr_read "$1" || return 1
  while [ "$pr_ms" = unknown ] && [ "$u" -lt 6 ]; do nap "$poll"; pr_read "$1" || return 1; u=$((u + 1)); done
  return 0
}
next_reconcile=0
reconcile() { # the open PR list (events are lost while the forwarder is down) and each open PR's mergeable_state
  local list n s f
  next_reconcile=$(($(date +%s) + reconcile_secs))
  list="$(ghx api "repos/$slug/pulls?state=open&per_page=100" | py_filter pulls)" || { say "reconcile: could not read the open PR list"; return 1; }
  for f in "$run"/open-*; do [ -e "$f" ] && rm -f "$f"; done
  while IFS=$'\t' read -r n s; do
    [ -n "$n" ] || continue
    : > "$run/open-$n"
    note_head "$n" "$s"
  done <<< "$list"
  read_mstates
  return 0
}
read_mstates() { # after every merge and every reconcile: GitHub sends no event when a PR starts to conflict
  local f n
  for f in "$run"/open-*; do
    [ -e "$f" ] || continue
    n="${f##*open-}"
    if pr_read "$n"; then printf '%s\n' "$pr_ms" > "$run/mstate-$n"; fi
  done
}

# ---------------------------------------------------------------------------------------------------------------------
# the steps for one PR
# ---------------------------------------------------------------------------------------------------------------------
code_conflicts() { # base ref, PR ref: 0 none or docs only, 1 a code conflict, 2 could not tell
  local out rc files bad
  out="$(git merge-tree --write-tree --name-only "$1" "$2" 2> /dev/null)"; rc=$?
  case "$rc" in 0) return 0 ;; 1) ;; *) return 2 ;; esac
  files="$(printf '%s\n' "$out" | sed '1d;/^$/,$d')"
  bad="$(printf '%s\n' "$files" | grep -vE "$docs_re" | sed '/^$/d')"
  [ -n "$bad" ] && return 1
  [ -z "$files" ] && return 1
  return 0
}
tree_clean() { # base ref, PR ref: 0 only when git merge-tree reports no conflict at all
  git merge-tree --write-tree --name-only "$1" "$2" > /dev/null 2>&1
}
fetch_pr() { # PR
  git fetch -q --no-prune origin main "+pull/$1/head:refs/pr-integrator/$1" > /dev/null 2>&1
}
run_gate() {
  if [ -n "${INTEGRATOR_GATE:-}" ]; then bg "$run/gate.log" "$INTEGRATOR_GATE"
  else bg "$run/gate.log" bash -c 'cd proto && ./scripts/gate'; fi
}
green_on() { # head sha: 0 green, 1 not yet, 2 red, 3 unreadable
  local v
  v="$(ghx api "repos/$slug/commits/$1/check-runs?per_page=100" | py_filter checks)" || return 3
  case "$v" in green) return 0 ;; red) return 2 ;; *) return 1 ;; esac
}
event_red() { # sha: a completed check of that sha that failed (a cancelled one counts: this is only asked for the current head)
  grep -Eq "^$1 completed (failure|timed_out|cancelled|startup_failure|action_required)$" "$run/checks.log" 2> /dev/null
}
event_done() { # sha: a completed success is in
  grep -Eq "^$1 completed success$" "$run/checks.log" 2> /dev/null
}

# wait for the checks of $2, the head we pushed (or found), to be green. 0 green; otherwise the reason (word) in $why
why=""
wait_checks() { # PR, sha
  local n=$1 sha=$2 end g first=1 left tick=0 hd
  end=$(($(date +%s) + check_wait))
  post_parked "$n" checks
  while true; do
    [ "$stopping" -eq 1 ] && return 1
    sup_alive || { say "the supervisor is gone; stopping"; exit 0; }
    drain_events
    if [ ! -e "$run/open-$n" ] && [ "$first" -eq 0 ]; then why=closed; return 1; fi
    hd=""; [ -s "$run/head-$n" ] && read -r hd < "$run/head-$n"
    if [ -n "$hd" ] && [ "$hd" != "$sha" ]; then why='head-changed'; return 1; fi
    if event_red "$sha"; then why=checks-failed; return 1; fi
    if [ "$first" -eq 1 ] || [ "$tick" -eq 1 ] || event_done "$sha"; then
      tick=0
      green_on "$sha"; g=$?
      case "$g" in 0) return 0 ;; 2) why=checks-failed; return 1 ;; esac
    fi
    first=0
    if [ "$(date +%s)" -ge "$end" ]; then why=timeout; return 1; fi
    ensure_forwarder || { why=forwarder; return 1; }
    left=$((next_reconcile - $(date +%s))); [ "$left" -lt 1 ] && left=1
    wait_events "$left"
    if [ "$(date +%s)" -ge "$next_reconcile" ]; then
      reconcile
      tick=1
      renew_claim
      [ "$claim_lost" -eq 1 ] && { why=claim; return 1; }
    fi
  done
}

# one PR through the queue; always ends with one word posted (merged or dropped), except when stopped or the claim is lost
process_pr() {
  local n=$1 rc head newhead
  cur=$n
  say "#$n: starting"
  pr_read "$n" || { post_dropped "$n" error; cur=""; return; }
  if [ "$pr_state" != open ]; then post_dropped "$n" closed; cur=""; return; fi
  : > "$run/open-$n"
  note_head "$n" "$pr_sha"
  if [ "$pr_sha" = - ] || [ "$pr_ref" = - ] || [ "$pr_repo" = - ]; then post_dropped "$n" error; cur=""; return; fi
  case "$(printf '%s' "$pr_repo" | tr '[:upper:]' '[:lower:]')" in "$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')") ;; *) say "#$n: a branch of another repository is not integrated"; post_dropped "$n" error; cur=""; return ;; esac
  if [ -n "$(git status --porcelain 2> /dev/null)" ]; then say "#$n: the working tree of $repo is not clean"; post_dropped "$n" error; cur=""; return; fi
  fetch_pr "$n" || { say "#$n: fetch failed"; post_dropped "$n" error; cur=""; return; }
  head="$pr_sha"
  # conflict pre-check, before anything is posted or touched
  code_conflicts origin/main "refs/pr-integrator/$n"; rc=$?
  if [ "$rc" -eq 1 ]; then post_dropped "$n" conflict; cur=""; return; fi
  if [ "$rc" -eq 2 ]; then say "#$n: git merge-tree could not tell (git 2.38 or newer is needed)"; post_dropped "$n" error; cur=""; return; fi
  # --merge-without-update (#867): a merge-tree with no conflict at all against current main skips the update
  clean=0
  if [ "$mwu" -eq 1 ] && tree_clean origin/main "refs/pr-integrator/$n"; then clean=1; fi
  post_integrating "$n"
  [ "$claim_lost" -eq 1 ] && { cur=""; return; }
  if [ "$clean" -eq 0 ] && ! git merge-base --is-ancestor origin/main "refs/pr-integrator/$n" 2> /dev/null; then
    git checkout -q -B "integrator/$n" "refs/pr-integrator/$n" > /dev/null 2>&1 || { post_dropped "$n" error; cur=""; return; }
    if ! git merge -q --no-edit origin/main > /dev/null 2>&1; then
      if [ -z "$(git diff --name-only --diff-filter=U)" ]; then git merge --abort > /dev/null 2>&1; post_dropped "$n" error; cur=""; return; fi
      if git diff --name-only --diff-filter=U | grep -qvE "$docs_re"; then git merge --abort > /dev/null 2>&1; post_dropped "$n" conflict; cur=""; return; fi
      # shellcheck disable=SC2046
      bash "$here/pr-sweep" --resolve-docs $(git diff --name-only --diff-filter=U)
      if git diff --name-only --diff-filter=U | xargs grep -l '^<<<<<<<' > /dev/null 2>&1; then git merge --abort > /dev/null 2>&1; post_dropped "$n" conflict; cur=""; return; fi
      git add -u
      git commit -q -m "Merge main into the branch (docs conflict)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>" > /dev/null 2>&1 || { git merge --abort > /dev/null 2>&1; post_dropped "$n" error; cur=""; return; }
    fi
    # #1093: a union-merged registry can be unsorted for rustfmt; format, commit, and re-check the compile before the gate
    if ! bash "$here/fmt-after-merge" > "$run/fmt.log" 2>&1; then say "#$n: fmt-after-merge failed"; tail -5 "$run/fmt.log" >&2; post_dropped "$n" checks-failed; cur=""; return; fi
    post_parked "$n" gate
    if ! run_gate; then say "#$n: the gate failed; not pushed (output kept in the state directory until exit)"; tail -5 "$run/gate.log" >&2; post_dropped "$n" checks-failed; cur=""; return; fi
    newhead="$(git rev-parse HEAD)"
    supersede "$n" "$head"
    if ! git push -q origin "integrator/$n:refs/heads/$pr_ref" > /dev/null 2>&1; then say "#$n: push failed (not forced)"; post_dropped "$n" error; cur=""; return; fi
    printf '%s\n' "$newhead" > "$run/head-$n"
    head="$newhead"
  fi
  post_checking "$n"
  [ "$claim_lost" -eq 1 ] && { cur=""; return; }
  why=""
  if ! wait_checks "$n" "$head"; then
    case "$why" in forwarder | claim) cur=""; return ;; esac
    [ "$stopping" -eq 1 ] && return
    post_dropped "$n" "${why:-error}"; cur=""; return
  fi
  # merge pinned to the head the checks were green on
  pr_read "$n" || { post_dropped "$n" error; cur=""; return; }
  if [ "$pr_sha" != "$head" ]; then post_dropped "$n" head-changed; cur=""; return; fi
  if [ "$clean" -eq 1 ]; then
    # main may have moved while the checks ran: the tree must still merge with no conflict at all
    if ! { fetch_pr "$n" && tree_clean origin/main "refs/pr-integrator/$n"; }; then post_dropped "$n" conflict; cur=""; return; fi
  fi
  ghx pr merge "$n" --repo "$slug" --merge --match-head-commit "$head" > /dev/null || true
  pr_read "$n" || { post_dropped "$n" error; cur=""; return; }
  if [ "$pr_merged" = true ]; then
    post_merged "$n"
    rm -f "$run/open-$n"
    say "#$n: merged"
    [ "$clean" -eq 1 ] && verify_after_merge "$n"
    after_merge "$n"
  else
    post_dropped "$n" error
  fi
  cur=""
}

# the queue as the board shows it: only digits and a state word are taken from the board text
queue() {
  "$klatch" board "$room" 2> /dev/null | awk '
    /^queue \(/ { inq = 1; next }
    inq && /^[^ ]/ { inq = 0 }
    inq' | sed -nE 's/^ +[0-9]+\. #([0-9]{1,9}) (waiting|integrating|checking)( .*)?$/\1/p'
}

# after every merge: read mergeable_state of each open PR again; a queued PR that now conflicts in code is dropped at once
after_merge() {
  local q n
  git fetch -q --no-prune origin main > /dev/null 2>&1
  read_mstates
  for n in $(queue); do
    [ "$n" = "$1" ] && continue
    [ "$(cat "$run/mstate-$n" 2> /dev/null)" = dirty ] || continue
    fetch_pr "$n" || continue
    code_conflicts origin/main "refs/pr-integrator/$n"; q=$?
    if [ "$q" -eq 1 ]; then post_dropped "$n" conflict; fi
  done
}

# ---------------------------------------------------------------------------------------------------------------------
# --merge-without-update (#867): verify main after a merge and revert it through a branch and a PR when main is red. Only
# the merge commit this run just made is ever judged or reverted. Every word is a fixed template of an integer.
# ---------------------------------------------------------------------------------------------------------------------
halt() { # PR, red | unverified: say so, release the claim, stop merging (exit 5)
  say "#$1: halting (main $2); the human must look before the integrator is started again"
  post_halted "$1" "$2"
  cur=""
  drop_claim
  exit 5
}
main_event_red() { # sha: a completed failed check suite or workflow run of that commit on main
  grep -Eq "^$1 completed (failure|timed_out|startup_failure|action_required)$" "$run/main-checks.log" 2> /dev/null
}
main_event_done() { grep -Eq "^$1 completed " "$run/main-checks.log" 2> /dev/null; }
main_state() { # sha: green pending red cancelled none (the check runs of that commit); 1 when unreadable
  ghx api "repos/$slug/commits/$1/check-runs?per_page=100" | py_filter mchecks
}
run_bench() {
  if [ -n "${INTEGRATOR_BENCH:-}" ]; then bg "$run/bench.log" "$INTEGRATOR_BENCH"
  else bg "$run/bench.log" bash -c 'cd proto && cargo run -q --release -p klatch-bench'; fi
}
# verify_main SHA PR: 0 green, 1 red, 2 not verified (timeout, cancelled, unreadable, no event source, stopped)
verify_main() {
  local sha=$1 n=$2 end first=1 tick=0 v left
  git fetch -q --no-prune origin main > /dev/null 2>&1
  if [ "$verify_gate" -eq 1 ]; then
    git checkout -q --detach "$sha" > /dev/null 2>&1 || return 2
    post_parked "$n" gate
    run_gate || { say "main at the merge of #$n: the gate failed"; return 1; }
  fi
  if [ "$verify_bench" -eq 1 ]; then
    git checkout -q --detach "$sha" > /dev/null 2>&1 || return 2
    run_bench || { say "main at the merge of #$n: the bench failed"; return 1; }
  fi
  end=$(($(date +%s) + verify_wait))
  while true; do
    [ "$stopping" -eq 1 ] && return 2
    drain_events
    main_event_red "$sha" && return 1
    if [ "$first" -eq 1 ] || [ "$tick" -eq 1 ] || main_event_done "$sha"; then
      tick=0
      v="$(main_state "$sha")" || v=unreadable
      case "$v" in green) return 0 ;; red) return 1 ;; esac
    fi
    first=0
    [ "$(date +%s)" -ge "$end" ] && return 2
    ensure_forwarder || return 2
    left=$((next_reconcile - $(date +%s))); [ "$left" -lt 1 ] && left=1
    wait_events "$left"
    if [ "$(date +%s)" -ge "$next_reconcile" ]; then
      reconcile
      tick=1
      renew_claim
      [ "$claim_lost" -eq 1 ] && return 2
    fi
  done
}
# revert_merge N SHA: the revert of the merge commit SHA of PR N, as a branch and a PR (never a push to main); 0 only when
# the revert PR was merged and main is green again
revert_merge() {
  local n=$1 s=$2 b="revert-$1" out r rsha np
  git fetch -q --no-prune origin main > /dev/null 2>&1 || return 1
  git merge-base --is-ancestor "$s" origin/main 2> /dev/null || return 1
  git checkout -q -B "$b" origin/main > /dev/null 2>&1 || return 1
  np="$(git rev-list --parents -n 1 "$s" 2> /dev/null | wc -w | tr -d ' ')"
  if [ "$np" -ge 3 ]; then git revert -m 1 --no-commit "$s" > /dev/null 2>&1; else git revert --no-commit "$s" > /dev/null 2>&1; fi || { git revert --abort > /dev/null 2>&1; git reset -q --hard > /dev/null 2>&1; return 1; }
  git commit -q -m "$(printf 'Revert PR #%d (main went red)\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>' "$n")" > /dev/null 2>&1 || { git reset -q --hard > /dev/null 2>&1; return 1; }
  rsha="$(git rev-parse HEAD)"
  git push -q origin "$b:refs/heads/$b" > /dev/null 2>&1 || return 1
  # one try only: a second pr create must not make a second PR
  out="$(perl -e 'alarm shift; exec @ARGV' "$gh_timeout" gh pr create --repo "$slug" --base main --head "$b" \
    --title "$(printf 'Revert PR #%d (main went red)' "$n")" \
    --body "$(printf 'The integrator merged PR #%d without updating its branch and main went red afterwards, so this reverts that merge. Its own checks decide whether it merges. A human should look at why main went red.' "$n")" 2> /dev/null)" || return 1
  r="$(printf '%s\n' "$out" | sed -nE 's#.*/pull/([0-9]{1,9})$#\1#p' | tail -1)"
  [ -n "$r" ] || return 1
  : > "$run/open-$r"; note_head "$r" "$rsha"
  why=""
  wait_checks "$r" "$rsha" || return 1
  pr_read "$r" || return 1
  [ "$pr_sha" = "$rsha" ] || return 1
  ghx pr merge "$r" --repo "$slug" --merge --match-head-commit "$rsha" > /dev/null || true
  pr_read "$r" || return 1
  [ "$pr_merged" = true ] || return 1
  rm -f "$run/open-$r"
  [ "$pr_msha" != - ] || return 1
  verify_main "$pr_msha" "$n"
}
verify_after_merge() { # PR just merged by this run
  local n=$1 ms=$pr_msha i=0 v
  while [ "$ms" = - ] && [ "$i" -lt 5 ]; do nap "$poll"; pr_read "$n" && ms=$pr_msha; i=$((i + 1)); done
  [ "$ms" != - ] || halt "$n" unverified
  verify_main "$ms" "$n"; v=$?
  case "$v" in
    0) return 0 ;;
    1) say "#$n: main is red after its merge; reverting through a branch and a PR"
       if revert_merge "$n" "$ms"; then post_reverted "$n"; return 0; fi
       halt "$n" red ;;
    *) halt "$n" unverified ;;
  esac
}

# ---------------------------------------------------------------------------------------------------------------------
# --dry-run (#1075): what the first real run would do. Reads only: klatch board and refusals, gh api GET, gh auth status
# and extension list, git fetch and merge-tree. It never posts, claims, pushes, makes a branch, merges, runs the gate or
# starts the forwarder. Everything printed is a fixed template, an integer, a word from a fixed list or a fixed message:
# never a title, a body, a branch name or a login. The would-post words repeat the templates of post_* above (the tests
# hold them equal).
# ---------------------------------------------------------------------------------------------------------------------
problems=0
out() { printf '%s\n' "$*"; }
chk_ok() { out "setup: $1: ok${2:+ ($2)}"; }
chk_bad() { out "setup: $1: PROBLEM $2: $3"; problems=$((problems + 1)); }

dry_setup() {
  local b refused perm g first holder
  # the role: klatch shows no role, so the one read-only sign is a recorded refusal of a merge:main claim by the rule `integrator`
  if ! b="$("$klatch" board "$room" 2> /dev/null)"; then
    chk_bad "klatch board" no-board "the board of room $room could not be read; check the member's identity and that it joined the room (klatch join $room)"
    b=""
  fi
  refused="$("$klatch" refusals --limit 50 2> /dev/null | awk -F'\t' '$4 == "claim" && $5 == "integrator" { n++ } END { print n + 0 }')"
  if [ "$refused" -gt 0 ] 2> /dev/null; then
    chk_bad role no-integrator-role "this member was refused the merge:main claim; the human runs: klatch admin integrator <this member>"
  else
    chk_ok role "no refusal on record; klatch shows no role, so the first real run proves it by taking the claim"
  fi
  if gh auth status > /dev/null 2>&1; then chk_ok "gh login"
  else chk_bad "gh login" no-gh-login "gh has no working login on this machine; run: gh auth login"; fi
  perm="$(ghx api "repos/$slug" | py_filter perm)" || perm=unreadable
  case "$perm" in
    admin) chk_ok "gh permission" "admin on $slug, which gh webhook forward needs" ;;
    push | none) chk_bad "gh permission" no-admin "the gh login has no admin on $slug (gh webhook forward creates a temporary webhook); log in as an account with repo admin" ;;
    *) chk_bad "gh permission" unreadable "the repository permission of $slug could not be read; check gh auth status and the repository name (INTEGRATOR_GH_REPO)" ;;
  esac
  if gh extension list 2> /dev/null | grep -q 'cli/gh-webhook'; then chk_ok "webhook extension"
  else chk_bad "webhook extension" no-webhook-extension "run: gh extension install cli/gh-webhook"; fi
  g=0
  if [ -n "$(git status --porcelain 2> /dev/null)" ]; then chk_bad clone dirty-clone "the clone has uncommitted or untracked files; use a dedicated clean clone"; g=1; fi
  if [ "$(git rev-parse --abbrev-ref HEAD 2> /dev/null)" != main ]; then chk_bad clone wrong-branch "the clone is not on main; check main out in it"; g=1; fi
  [ "$g" -eq 0 ] && chk_ok clone "clean, on main"
  if [ -n "${INTEGRATOR_GATE:-}" ]; then
    # shellcheck disable=SC2086
    set -- $INTEGRATOR_GATE; first="$1"
    if command -v "$first" > /dev/null 2>&1; then chk_ok gate "the INTEGRATOR_GATE command is present"
    else chk_bad gate no-gate "the INTEGRATOR_GATE command was not found; fix the setting or unset it"; fi
  elif [ -x proto/scripts/gate ]; then chk_ok gate "proto/scripts/gate is present"
  else chk_bad gate no-gate "proto/scripts/gate is missing or not executable in the clone; update it to a current main"; fi
  holder="$(printf '%s\n' "$b" | sed -nE 's/^queue \(merge:main held by ([A-Za-z0-9._-]{1,40})\):.*/\1/p' | head -1)"
  if [ -n "$holder" ]; then chk_ok "merge:main" "held by $holder right now; a real run waits until it is free"
  else chk_ok "merge:main" "free, or no queue on the board"; fi
}

dry_pr() { # one queued PR: the words a real run would post, in order
  local n=$1 tip rc
  out "queue #$n:"
  if ! pr_read "$n"; then out "  would post: $(printf 'dropped: #%d error' "$n")  (the PR could not be read)"; return; fi
  if [ "$pr_state" != open ]; then out "  would post: $(printf 'dropped: #%d closed' "$n")"; return; fi
  if [ "$pr_sha" = - ] || [ "$pr_ref" = - ] || [ "$pr_repo" = - ]; then out "  would post: $(printf 'dropped: #%d error' "$n")  (the branch is not a plain name)"; return; fi
  case "$(printf '%s' "$pr_repo" | tr '[:upper:]' '[:lower:]')" in "$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')") ;;
    *) out "  would post: $(printf 'dropped: #%d error' "$n")  (a branch of another repository is not integrated)"; return ;; esac
  if ! { git fetch -q --no-prune origin main && git fetch -q --no-prune origin "pull/$n/head"; } > /dev/null 2>&1; then
    out "  would post: $(printf 'dropped: #%d error' "$n")  (fetch failed)"; return
  fi
  tip="$(git rev-parse FETCH_HEAD 2> /dev/null)"
  case "$tip" in *[!0-9a-f]* | '') out "  would post: $(printf 'dropped: #%d error' "$n")"; return ;; esac
  code_conflicts origin/main "$tip"; rc=$?
  if [ "$rc" -eq 1 ]; then out "  would post: $(printf 'dropped: #%d conflict' "$n")  (a code conflict with main, found before anything is touched)"; return; fi
  if [ "$rc" -eq 2 ]; then out "  would post: $(printf 'dropped: #%d error' "$n")  (git merge-tree could not tell; git 2.38 or newer is needed)"; return; fi
  out "  would post: $(printf 'integrating: #%d' "$n")"
  if [ "$mwu" -eq 1 ] && tree_clean origin/main "$tip"; then
    out "  would skip merging main into the branch: git merge-tree is clean against current main (--merge-without-update)"
    out "  would post: $(printf 'checking: #%d' "$n")"
    out "  would post: $(printf 'parked: waiting for checks on #%d, back by %dm' "$n" "$park_min")"
    out "  would wait for the checks of the PR's current head to be green"
    out "  would run gh pr merge $n --merge --match-head-commit <the head the checks were green on>"
    out "  would post: $(printf 'merged: #%d' "$n")"
    out "  would verify main: wait for the check suite and workflow run events of the merge commit, and read its check runs"
    if [ "$verify_gate" -eq 1 ]; then
      out "  would post: $(printf 'parked: running the gate for #%d, back by %dm' "$n" "$park_min")"
      out "  would run the gate on main at the merge commit"
    fi
    [ "$verify_bench" -eq 1 ] && out "  would run the bench on main at the merge commit"
    out "  would revert, only if main is red at that merge commit: branch revert-$n, git revert -m 1, a plain push of that branch (never a push to main), a PR with a fixed title and body, its own green checks, then the same pinned merge"
    out "  would post: $(printf 'reverted: #%d' "$n")  (or halted: main red after #$n, or halted: main not verified after #$n, and exit 5)"
    return
  fi
  if ! git merge-base --is-ancestor origin/main "$tip" 2> /dev/null; then
    out "  would merge origin/main into a local branch integrator/$n (docs conflicts keep both sides)"
    out "  would post: $(printf 'parked: running the gate for #%d, back by %dm' "$n" "$park_min")"
    out "  would run the gate"
    out "  would push the merged branch to the PR's own branch (a plain push, never forced)"
  else
    out "  main is already in the branch: no merge, no gate, no push"
  fi
  out "  would post: $(printf 'checking: #%d' "$n")"
  out "  would post: $(printf 'parked: waiting for checks on #%d, back by %dm' "$n" "$park_min")"
  out "  would wait for the checks of the current head to be green"
  out "  would run gh pr merge $n --merge --match-head-commit <the head the checks were green on>"
  out "  would post: $(printf 'merged: #%d' "$n")"
}

dry_run() {
  local list q n count
  out "dry run: $slug, room $room"
  [ "$mwu" -eq 1 ] && out "mode: merge without update (--merge-without-update): a PR whose merge-tree against main is clean is merged with no update of its branch, then main is verified and a red merge is reverted; this replaces the up-to-date rule for it"
  dry_setup
  list="$(ghx api "repos/$slug/pulls?state=open&per_page=100" | py_filter pulls)" || list=""
  count="$(printf '%s\n' "$list" | sed '/^$/d' | wc -l | tr -d ' ')"
  out "open PRs read from GitHub: $count"
  q="$(queue | tr '\n' ' ')"
  if [ -z "${q// /}" ]; then
    out "the queue is empty: nothing would be posted or merged"
  else
    out "the queue on the board: $(printf '%s' "$q" | sed -E 's/([0-9]+)/#\1/g; s/ +$//')"
    out "would take the merge:main claim (lease ${lease}s), then release it when the queue is empty"
    out "would start gh webhook forward --repo $slug --events pull_request,check_suite,workflow_run"
    for n in $q; do dry_pr "$n"; done
    out "(each PR is checked against main as it is now; a real run checks again after the PR before it merged)"
  fi
  if [ "$problems" -gt 0 ]; then out "dry run: $problems setup problem(s) above; fix them before the first real run"; fi
  out "dry run: nothing was changed."
  [ "$problems" -eq 0 ]
}

# ---------------------------------------------------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------------------------------------------------
if [ "$dry" -eq 1 ]; then dry_run; exit $?; fi
take_claim; rc=$?
case "$rc" in
  0) drop_claim ;; # the probe: this member may take merge:main; it is taken again when there is work
  1) say "this member may not take merge:main (the integrator role is the human's to grant: klatch admin integrator <member>)"; exit 2 ;;
  *) say "merge:main is held by another member (or could not be claimed); not starting"; exit 3 ;;
esac

start_forwarder || { say "cannot start the webhook forwarder"; exit 4; }
reconcile

say "running as an integrator for $slug in room $room"
while true; do
  [ "$stopping" -eq 1 ] && exit 0
  sup_alive || { say "the supervisor is gone; stopping"; exit 0; }
  ensure_forwarder || { say "the event source cannot be kept running; releasing merge:main and stopping"; drop_claim; exit 4; }
  drain_events
  [ "$(date +%s)" -ge "$next_reconcile" ] && reconcile
  q=""
  now=$(date +%s)
  for n in $(queue); do
    d="$(cat "$run/done-$n" 2> /dev/null || echo 0)"
    [ $((now - d)) -lt "$requeue_secs" ] && continue
    q="$n"; break
  done
  if [ -z "$q" ]; then
    drop_claim
    [ "$once" -eq 1 ] && exit 0
    # wait for a ready word, woken by klatch; the timeout is the reconcile interval
    bg "$run/wait.out" "$klatch" wait "$room" --only "ready:" --timeout "$reconcile_secs"
    [ "$(wc -l < "$run/ev.tsv" | tr -d ' ')" -gt 10000 ] && { : > "$run/ev.tsv"; off=0; }
    continue
  fi
  if [ "$held" -eq 0 ]; then
    take_claim; rc=$?
    case "$rc" in
      0) ;;
      1) say "the integrator role was removed; stopping"; exit 2 ;;
      *) say "merge:main is held by another member; waiting"; bg "$run/wait.out" "$klatch" wait "$room" --timeout 5; continue ;;
    esac
  fi
  claim_lost=0
  process_pr "$q"
  date +%s > "$run/done-$q"
  [ "$claim_lost" -eq 1 ] && { say "the claim was lost; stopping"; held=0; exit 3; }
done
