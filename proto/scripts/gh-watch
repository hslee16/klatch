#!/usr/bin/env bash
# Launcher for the webhook-driven GitHub watcher (#1329; docs in PR-SWEEP.md, "GitHub watcher").
#   gh-watch serve [receiver options]   run the loopback receiver in the foreground (detach it with nohup, see the docs)
#   gh-watch selftest                   run the fixture tests (nothing leaves this machine)
#   gh-watch forward-command [opts]     PRINT the commands the human runs; it runs none of them
#   gh-watch status [opts]              is the receiver up, is a forwarder for this repo running, how old is the last note;
#                                       last line gh-watch: ok (exit 0), receiver down (3), forwarder down (4) or
#                                       forwarder down: stale webhook (5; run clean-hooks, #1350)
#   gh-watch clean-hooks                READ-ONLY `gh api repos/OWNER/REPO/hooks`, run only when you ask: lists a stale
#                                       development webhook and PRINTS the delete command; it deletes nothing (#1350)
#   gh-watch install-launchd [opts]     PRINT two LaunchAgent plists (receiver, forwarder wrapper) and the launchctl commands;
#                                       --systemd prints systemd user units instead. Writes nothing, runs nothing (#1343)
#   gh-watch ensure [opts]              start ONLY the receiver, detached, if it is down (never the forwarder, never gh); then status
# serve options: --out-dir DIR --secret-file FILE --port N --klatch-bin PATH --as-member NAME --room NAME
#                --post-min INFO|ALERT --max-body BYTES --no-claim --claim-ttl S --claim-renew S   (--bind is accepted but only loopback is allowed)
# The watcher is read-only: it never calls gh or GitHub. This launcher runs gh only in clean-hooks (one read-only GET); status
# uses ps and, when present, a read-only launchctl print.
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
receiver="$here/gh-watch-receiver.py"
repo_slug="hslee16/klatch"
events="pull_request,check_run,workflow_run,push,issues,issue_comment"

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "gh-watch: $*" >&2; exit 2; }

default_out="${GH_WATCH_DIR:-${XDG_STATE_HOME:-${HOME:?}/.local/state}/klatch-gh-watch}"
out_dir="$default_out"; secret_file=""; port=8787

# read --out-dir, --secret-file and --port out of the arguments (the rest is passed on untouched)
scan_args() {
  rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --out-dir) [ $# -ge 2 ] || die "--out-dir needs a value"; out_dir="$2"; shift 2 ;;
      --secret-file) [ $# -ge 2 ] || die "--secret-file needs a value"; secret_file="$2"; shift 2 ;;
      --port) [ $# -ge 2 ] || die "--port needs a value"; port="$2"; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$secret_file" ] || secret_file="$out_dir/secret"
  case "$port" in '' | *[!0-9]*) die "--port must be a number" ;; esac
  case "$out_dir/" in */.klatch/*) die "--out-dir must not be inside .klatch (never the live store)" ;; esac
}

pid_file() { printf '%s/gh-watch.pid' "$out_dir"; }

# The receiver runs as a child so this wrapper can remove the pid file when it ends (a kill -9 of the receiver included).
cmd_serve() {
  scan_args "$@"
  (umask 077; mkdir -p "$out_dir") || die "cannot create $out_dir"
  python3 -I "$receiver" --out-dir "$out_dir" --secret-file "$secret_file" --port "$port" ${rest[@]+"${rest[@]}"} &
  local child=$! rc
  printf '%s\n' "$child" > "$(pid_file)"
  trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
  wait "$child"; rc=$?
  trap - TERM INT HUP
  wait "$child" 2>/dev/null
  rm -f "$(pid_file)"
  exit "$rc"
}

cmd_selftest() { exec python3 -I "$here/test_gh_watch.py"; }

cmd_forward_command() {
  scan_args "$@"
  echo "# Run these yourself; gh-watch never runs them. Nothing here is run by an agent."
  echo
  echo "# 1. One time: allow gh to manage repository webhooks (opens a browser to confirm)"
  echo "gh auth refresh -s admin:repo_hook"
  echo
  echo "# 2. One time: create the secret file (mode 0600, only you can read it; the receiver refuses anything looser)"
  # shellcheck disable=SC2016
  printf "(umask 077; mkdir -p %q; python3 -c 'import secrets; print(secrets.token_hex(32))' > %q)\n" "$out_dir" "$secret_file"
  echo
  echo "# 3. Start the receiver (see PR-SWEEP.md for the nohup form):"
  printf '%q serve --out-dir %q --secret-file %q --port %s\n' "$here/gh-watch" "$out_dir" "$secret_file" "$port"
  echo
  echo "# 4. Forward the repository events to it (keep it running; it creates a development webhook on the repository)"
  # shellcheck disable=SC2016  # the $(cat ...) is meant to be printed, not expanded here
  printf 'gh webhook forward --repo=%s --events=%s --url=http://127.0.0.1:%s/hook --secret "$(cat %q)"\n' "$repo_slug" "$events" "$port" "$secret_file"
  echo
  echo "# Watch the notes with:  tail -F $out_dir/gh-watch.log"
}

# --- install-launchd (#1343): PRINTS only. No file is written, launchctl and gh are never run. -------------------------
cmd_install_launchd() {
  local systemd=0 args=()
  while [ $# -gt 0 ]; do
    case "$1" in --systemd) systemd=1; shift ;; *) args+=("$1"); shift ;; esac
  done
  scan_args ${args[@]+"${args[@]}"}
  [ ${#rest[@]} -eq 0 ] || die "install-launchd: unknown option ${rest[0]}"
  if [ "$systemd" -eq 1 ]; then print_systemd; else print_plists; fi
}

# One plist, built with plistlib so paths are escaped correctly. Holds no secret: only the path of the secret file.
emit_plist() {
  python3 -I -c '
import plistlib, sys
here, out, secret, port, label, kind = sys.argv[1:7]
script = "gh-watch" if kind == "receiver" else "gh-watch-forward"
args = [here + "/" + script] + (["serve"] if kind == "receiver" else []) + [
    "--out-dir", out, "--secret-file", secret, "--port", port]
d = {"Label": label, "ProgramArguments": args, "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 30,
     "StandardOutPath": out + "/" + kind + ".launchd.out", "StandardErrorPath": out + "/" + kind + ".launchd.err",
     "EnvironmentVariables": {"PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"}}
sys.stdout.write(plistlib.dumps(d).decode())
' "$here" "$out_dir" "$secret_file" "$port" "$1" "$2"
}

print_plists() {
  local rlabel="dev.klatch.gh-watch-receiver" flabel="dev.klatch.gh-watch-forwarder"
  # shellcheck disable=SC2088  # the tilde is printed for the human to read, never expanded here
  local la='~/Library/LaunchAgents'
  echo "# Run these yourself; gh-watch never writes into ~/Library, never runs launchctl and never runs gh."
  echo "# Prerequisites: the secret file exists (gh-watch forward-command, step 2) and you ran: gh auth refresh -s admin:repo_hook"
  echo "# The plists hold no secret. The receiver reads $secret_file (mode 0600); gh-watch-forward reads it and passes"
  echo "# it to gh webhook forward as --secret, so the secret is visible in ps to your own user until #1333 is settled."
  echo "# Loopback only: the receiver binds 127.0.0.1:$port and the forwarder posts to http://127.0.0.1:$port/hook."
  echo
  echo "# 1. Save each block below as ~/Library/LaunchAgents/LABEL.plist"
  echo
  echo "# --- $la/$rlabel.plist"
  emit_plist "$rlabel" receiver
  echo
  echo "# --- $la/$flabel.plist"
  emit_plist "$flabel" forwarder
  echo
  echo "# 2. Create the state dir (the log files go there), then load both jobs:"
  printf 'mkdir -p -m 700 %q\n' "$out_dir"
  for label in "$rlabel" "$flabel"; do
    echo "launchctl bootstrap gui/\$(id -u) $la/$label.plist"
  done
  echo
  echo "# 3. Check them (read-only):"
  for label in "$rlabel" "$flabel"; do
    echo "launchctl print gui/\$(id -u)/$label"
  done
  echo "$here/gh-watch status"
  echo
  echo "# 4. To stop and unload:"
  for label in "$rlabel" "$flabel"; do
    echo "launchctl bootout gui/\$(id -u)/$label"
  done
}

print_systemd() {
  # shellcheck disable=SC2088
  local unitdir='~/.config/systemd/user'
  echo "# Run these yourself; gh-watch never writes a unit file, never runs systemctl and never runs gh."
  echo "# The units hold no secret. gh-watch-forward reads $secret_file (mode 0600) and passes it to gh webhook forward"
  echo "# as --secret, so the secret is visible in ps to your own user until #1333 is settled. Loopback only (127.0.0.1:$port)."
  echo
  echo "# --- $unitdir/gh-watch-receiver.service"
  cat <<UNIT
[Unit]
Description=klatch gh-watch receiver (loopback)

[Service]
ExecStart=$here/gh-watch serve --out-dir $out_dir --secret-file $secret_file --port $port
Restart=always
RestartSec=30
StandardOutput=append:$out_dir/receiver.launchd.out
StandardError=append:$out_dir/receiver.launchd.err

[Install]
WantedBy=default.target
UNIT
  echo
  echo "# --- $unitdir/gh-watch-forwarder.service"
  cat <<UNIT
[Unit]
Description=klatch gh-watch forwarder (gh webhook forward)
After=gh-watch-receiver.service

[Service]
ExecStart=$here/gh-watch-forward --out-dir $out_dir --secret-file $secret_file --port $port
Restart=always
RestartSec=30
StandardOutput=append:$out_dir/forwarder.launchd.out
StandardError=append:$out_dir/forwarder.launchd.err

[Install]
WantedBy=default.target
UNIT
  echo
  echo "# Then:"
  printf 'mkdir -p -m 700 %q\n' "$out_dir"
  echo "systemctl --user daemon-reload"
  echo "systemctl --user enable --now gh-watch-receiver.service gh-watch-forwarder.service"
  echo "systemctl --user status gh-watch-receiver.service gh-watch-forwarder.service"
  echo "# To stop: systemctl --user disable --now gh-watch-receiver.service gh-watch-forwarder.service"
}

# --- status and ensure (#1335) ---------------------------------------------------------------------------------------
# "Receiver running" means BOTH: the pid in gh-watch.pid is alive (kill -0) AND a TCP connect to 127.0.0.1:PORT succeeds.
# The pid file alone goes stale after a crash or reboot; the port alone would count any other program on that port.
receiver_up() {
  local pid
  pid="$(head -n 1 "$(pid_file)" 2>/dev/null)"
  case "$pid" in '' | *[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null
}

# A `gh webhook forward` process for this repo, from ps. Only a yes or no leaves this function: the secret is on that
# command line and must never be printed.
forwarder_up() {
  local line
  while IFS= read -r line; do
    case "$line" in
      *"gh webhook forward"*"--repo=$repo_slug"* | *"gh webhook forward"*"--repo $repo_slug"*) return 0 ;;
    esac
  done < <(ps -axo command= 2>/dev/null)
  return 1
}

log_age_line() {
  python3 -I -c '
import os, sys, time
p = sys.argv[1]
try:
    st = os.stat(p)
except OSError:
    print("last log line: none (no gh-watch.log yet)"); raise SystemExit
if st.st_size == 0:
    print("last log line: none (no log lines yet)")
else:
    print("last log line: %d s ago" % max(0, int(time.time() - st.st_mtime)))
' "$out_dir/gh-watch.log"
}

# Read-only: `launchctl print gui/UID/LABEL` per job. Skipped silently where launchctl does not exist (Linux).
launchd_lines() {
  command -v launchctl >/dev/null 2>&1 || return 0
  local uid st kind label
  uid="$(id -u)"
  for kind in receiver forwarder; do
    label="dev.klatch.gh-watch-$kind"
    st="not loaded"
    launchctl print "gui/$uid/$label" >/dev/null 2>&1 && st="loaded"
    echo "launchd $kind job ($label): $st"
  done
}

print_status() {
  local rec="down" fwd="down"
  receiver_up && rec="up"
  forwarder_up && fwd="up"
  echo "receiver: $rec (127.0.0.1:$port, pid file $(pid_file))"
  echo "forwarder for $repo_slug: $fwd"
  launchd_lines
  log_age_line
  if [ "$rec" = down ]; then echo "gh-watch: receiver down"; return 3; fi
  if [ "$fwd" = down ] && [ -s "$out_dir/forwarder.stale" ]; then
    head -n 1 "$out_dir/forwarder.stale"
    echo "gh-watch: forwarder down: stale webhook"; return 5
  fi
  if [ "$fwd" = down ]; then echo "gh-watch: forwarder down"; return 4; fi
  echo "gh-watch: ok"
}

cmd_status() { scan_args "$@"; print_status; }

# --- clean-hooks (#1350): one read-only GET, only when the human runs it. It never deletes; it prints the command. --------
# gh webhook forward creates a hook named cli whose config.url is the GitHub forwarding service; only such hooks are listed.
cmd_clean_hooks() {
  scan_args "$@"
  [ ${#rest[@]} -eq 0 ] || die "clean-hooks: unknown option ${rest[0]} (it never deletes; there is no delete flag)"
  local json
  json="$(gh api "repos/$repo_slug/hooks" 2>&1)" || {
    echo "gh-watch: cannot list the hooks of $repo_slug (needs gh auth refresh -s admin:repo_hook): $json" >&2
    exit 1
  }
  # shellcheck disable=SC2016  # the $(id -u) in the printed hint is for the human, not expanded here
  python3 -I -c '
import json, sys
repo, text = sys.argv[1], sys.stdin.read()
try:
    hooks = json.loads(text)
except ValueError:
    print("gh-watch: the hooks answer was not JSON", file=sys.stderr); raise SystemExit(1)
stale = [h for h in hooks if isinstance(h, dict) and h.get("name") == "cli"
         and str((h.get("config") or {}).get("url", "")).split("/")[2:3] in (["webhook-forwarder.github.com"], ["web.github.com"])]
if not stale:
    print("no stale development webhook on %s" % repo); raise SystemExit(0)
print("# Stale development webhook(s) on %s (name cli, GitHub forwarding URL)." % repo)
print("# Stop the forwarder first (launchctl bootout gui/$(id -u)/dev.klatch.gh-watch-forwarder), then run yourself:")
for h in stale:
    print("gh api -X DELETE repos/%s/hooks/%d" % (repo, int(h["id"])))
' "$repo_slug" <<< "$json"
}

# Starts only the receiver. Never the forwarder, never gh: the forwarder needs the human's admin:repo_hook token.
cmd_ensure() {
  scan_args "$@"
  if ! receiver_up; then
    (umask 077; mkdir -p "$out_dir") || die "cannot create $out_dir"
    chmod 700 "$out_dir" 2>/dev/null
    if [ ! -e "$secret_file" ]; then
      (umask 077; python3 -I -c 'import secrets; print(secrets.token_hex(32))' > "$secret_file") || die "cannot create the secret file"
      chmod 600 "$secret_file"
    fi
    nohup "$here/gh-watch" serve --out-dir "$out_dir" --secret-file "$secret_file" --port "$port" ${rest[@]+"${rest[@]}"} \
      < /dev/null >> "$out_dir/serve.out" 2>&1 &
    disown 2>/dev/null
    local i=0
    while [ "$i" -lt 100 ] && ! receiver_up; do i=$((i + 1)); sleep 0.1; done
  fi
  print_status; local rc=$?
  [ "$rc" -eq 4 ] && echo "The forwarder is the human's to start (it needs the admin:repo_hook token): run gh-watch forward-command and use step 4."
  exit "$rc"
}

case "${1:-}" in
  status) shift; cmd_status "$@"; exit $? ;;
  ensure) shift; cmd_ensure "$@" ;;
  serve) shift; cmd_serve "$@" ;;
  selftest) cmd_selftest ;;
  install-launchd) shift; cmd_install_launchd "$@" ;;
  forward-command) shift; cmd_forward_command "$@" ;;
  clean-hooks) shift; cmd_clean_hooks "$@" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
